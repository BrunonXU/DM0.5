<?xml version="1.0" encoding="UTF-8"?>
<!-- F1-09 camera processes only; Fast DDS 2.14.6.
     192.0.2.2 is enP3p1s0f1, verified on 2026-09-28.
     Keep the original camera RMW, QoS, rates, and shared-memory transport.
     Load with FASTRTPS_DEFAULT_PROFILES_FILE in the camera wrapper only.
     Schema: eProsima/Fast-DDS v2.14.6 resources/xsd/fastRTPS_profiles.xsd -->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>f1_camera_internal_udp</transport_id>
        <type>UDPv4</type>
        <interfaceWhiteList>
          <address>127.0.0.1</address>
          <address>192.0.2.2</address>
        </interfaceWhiteList>
      </transport_descriptor>
      <transport_descriptor>
        <transport_id>f1_camera_shm</transport_id>
        <type>SHM</type>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="f1_camera_internal" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>f1_camera_internal_udp</transport_id>
          <transport_id>f1_camera_shm</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
