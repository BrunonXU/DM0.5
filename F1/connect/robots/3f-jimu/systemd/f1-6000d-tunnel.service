[Unit]
Description=3F-JIMU reverse SSH tunnel to 6000D (loopback 22165)
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/ssh -F /home/user/Bruno/connect/ssh_config -NT -R 127.0.0.1:22165:127.0.0.1:22 6000d-3f-jimu-tunnel
Restart=always
RestartSec=10s
TimeoutStopSec=15s
UMask=0077
NoNewPrivileges=yes
StandardOutput=append:/home/user/Bruno/connect/tunnel.log
StandardError=inherit

[Install]
WantedBy=default.target
