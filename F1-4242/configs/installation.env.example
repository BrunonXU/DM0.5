# Copy to installation.env on the target robot. run.sh sources this file.
# Values below are examples for the existing ROS Jazzy / F1 installation.
export F1_INFRA_HOME="$HOME/Bruno/F1-infra"
export F1_CONSOLE_RUNTIME="$F1_INFRA_HOME/runtime"
export F1_PROFILE_PATH="$HERE/configs/robot.json"
export F1_CONTROL_LOCK="$F1_CONSOLE_RUNTIME/control.lock"
export F1_CONSOLE_PORT=4242
export F1_ROS_SETUP=/opt/ros/jazzy/setup.bash
export F1_ROBOT_SETUP=/home/user/workspace/f1/install/setup.bash
export F1_AGV_SETUP=/home/user/workspace/agv/install/setup.bash
export F1_CYCLONEDDS_URI=/etc/ros/cyclonedds/cyclonedds.xml
export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
export ROS_DOMAIN_ID=0
export F1_CONSOLE_PYTHON=/usr/bin/python3
export F1_RECORDING_PYTHON="$F1_CONSOLE_RUNTIME/recording-venv/bin/python"
export F1_LXL_ROOT=/home/user/lxl
export PICO_UPPER_ROOT="$HERE/integrations/pico_upper"
export PICO_UPPER_RUNTIME="$F1_CONSOLE_RUNTIME/pico_upper"
export PICO_UPPER_CONTROL_LOCK="$F1_CONTROL_LOCK"
# Optional Pico environment / XR SDK installed on the target machine.
export PICO_UPPER_PYTHON=/home/user/miniconda3/envs/pico4ultra_py312/bin/python
export PICO_UPPER_SDK_ROOT=/home/user/lxl/XRoboToolkit-Teleop-Sample-Python/dependencies/XRoboToolkit-PC-Service-Pybind
# Existing F1-09 deployments must keep their shared control lock if coexisting.
# Do not copy this example over an existing installation without review.
