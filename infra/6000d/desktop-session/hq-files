#!/usr/bin/python3
"""6000D personal file-manager entry; does not belong in the F1 release ZIP."""
import os
from pathlib import Path
import re
import stat
import subprocess
import sys


def main():
    env = os.environ.copy()
    args = sys.argv[1:]
    if args == ['--session-start']:
        display = re.fullmatch(r':(\d+)(?:\.\d+)?', env.get('DISPLAY', ''))
        if not display:
            raise SystemExit('A local graphical session is required.')
        socket = Path(f'/tmp/.X11-unix/X{int(display.group(1))}')
        info = socket.stat()
        if not stat.S_ISSOCK(info.st_mode) or info.st_uid != os.getuid():
            raise SystemExit('The graphical session must belong to this account.')
    env['XDG_RUNTIME_DIR'] = f'/run/user/{os.getuid()}'
    env['DBUS_SESSION_BUS_ADDRESS'] = f"unix:path={env['XDG_RUNTIME_DIR']}/bus"
    # Import only graphical routing, never the full environment or credentials.
    names = []
    if env.get('DISPLAY'):
        names.append('DISPLAY')
        env['XDG_SESSION_TYPE'] = 'x11'
        names.append('XDG_SESSION_TYPE')
        authority = Path(env.get('XAUTHORITY') or Path.home() / '.Xauthority')
        if authority.is_file():
            env['XAUTHORITY'] = str(authority)
            names.append('XAUTHORITY')
    if names:
        try:
            subprocess.run(['/usr/bin/dbus-update-activation-environment', '--systemd', *names],
                           env=env, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, timeout=5, check=False)
        except subprocess.TimeoutExpired:
            pass
    if args == ['--session-start']:
        subprocess.run(['/usr/bin/systemctl', '--user', 'start', 'hq-share-autoconnect.timer'],
                       env=env, check=False, timeout=10)
        return
    if args == ['--share']:
        # A manual login takes priority over a pending background attempt.
        subprocess.run(['/usr/bin/systemctl', '--user', 'stop', 'hq-share-autoconnect.service'],
                       env=env, check=False, timeout=30)
        subprocess.run([str(Path.home() / '.local/bin/hq-share-autoconnect'), '--reset'],
                       env=env, check=False, timeout=10, stdout=subprocess.DEVNULL)
        args = ['--new-window', 'smb://company.example.invalid/机器人软件共享盘/']
    if not args:
        args = ['--new-window']
    os.execve('/usr/bin/nautilus', ['nautilus', *args], env)


if __name__ == '__main__':
    main()
